# Charger depuis MLflow ou joblib local
MODEL_SOURCE=joblib           # "mlflow" ou "joblib"

# Cas MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_MODEL_URI=runs:/xxxxxxxxxxxxxxxxxxxxxxxxxxxx/model    # ou models:/Name/Production

# Cas joblib (par défaut)
MODEL_PATH=./models/final_lightgbm_model.joblib
MODELS_DIR=./models
JOBLIB_FILENAME=final_lightgbm_model.joblib
FEATURES_JSON=./models/features.json

# Seuil métier : si non présent dans le .joblib, on prend celui-ci
PRED_THRESHOLD=0.084065

# Divers
API_TITLE=HomeCredit Scoring API
API_VERSION=0.1.0
